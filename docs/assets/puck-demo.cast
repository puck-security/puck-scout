[16.1, "o", "\r\n"]
[16.5, "o", "\u001b[36m⏺\u001b[0m Calling \u001b[1mpuck_query_fleet\u001b[0m \u001b[90m(crontab -l + systemctl list-timers)\u001b[0m\r\n"]
[17.0, "o", "  \u001b[32m→\u001b[0m \u001b[1m4 of 9\u001b[0m running trivy as a scheduled job\r\n"]
