[14.3, "o", "\r\n"]
[14.7, "o", "\u001b[36m⏺\u001b[0m Calling \u001b[1mpuck_query_fleet\u001b[0m \u001b[90m(dpkg -l | grep trivy across 31 hosts)\u001b[0m\r\n"]
[15.2, "o", "  \u001b[32m→\u001b[0m 31 hosts queried in parallel\r\n"]
